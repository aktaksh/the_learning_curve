   "source": [
    "import copy\n",
    "a  = [[1,2], [3,4]]\n",
    "print(id([[1,2], [3,4]]))\n",
    "\n",
    "print(id(a))\n",
    "b = copy.copy(a)\n",
    "print(id([[1,2], [3,4]]))\n",
    "\n",
    "print(id(b))\n",
    "c = copy.deepcopy(a)\n",
    "print(id([[1,2], [3,4]]))\n",
    "print(id(c))\n",
    "\n",
    "a[0][0] = 99\n",
    "print(a[0][0])\n",
    "print(b[0][0])\n",
    "print(c[0][0])"
   ]
  }
